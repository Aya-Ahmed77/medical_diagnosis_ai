# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Flask ---
FLASK_ENV=development
API_HOST=0.0.0.0
API_PORT=5000
SECRET_KEY=change-me-in-production

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=medical_diagnosis_ai
CONDITIONS_COLLECTION=conditions
MODELS_COLLECTION=models

# --- Scraper ---
NHS_BASE_URL=https://www.nhsinform.scot/illnesses-and-conditions/a-to-z/
SCRAPER_USER_AGENT=MedicalDiagnosisAI-EducationalProject/1.0
SCRAPER_REQUEST_TIMEOUT=10
SCRAPER_MAX_RETRIES=3
SCRAPER_RATE_LIMIT_SECONDS=1.0
SCRAPER_MAX_CONDITIONS=20

# --- Preprocessing / dataset ---
RANDOM_SEED=42
TRAIN_SPLIT=0.7
VAL_SPLIT=0.15
TEST_SPLIT=0.15
SYNTHETIC_EXAMPLES_PER_CONDITION=8

# --- Baseline model ---
TFIDF_MAX_FEATURES=5000
TFIDF_NGRAM_MAX=2
LOGREG_MAX_ITER=1000

# --- RNN / LSTM ---
VOCAB_SIZE=8000
MAX_SEQUENCE_LENGTH=64
EMBEDDING_DIM=128
RNN_UNITS=64
LSTM_UNITS=64
DL_EPOCHS=20
DL_BATCH_SIZE=16
DL_LEARNING_RATE=0.001
EARLY_STOPPING_PATIENCE=3

# --- Transformer ---
TRANSFORMER_MODEL_NAME=dmis-lab/biobert-base-cased-v1.2
TRANSFORMER_FALLBACK_MODEL_NAME=bert-base-uncased
TRANSFORMER_MAX_LENGTH=128
TRANSFORMER_EPOCHS=4
TRANSFORMER_BATCH_SIZE=8
TRANSFORMER_LEARNING_RATE=0.00002

# --- Prediction ---
PREDICTION_TOP_N=5
